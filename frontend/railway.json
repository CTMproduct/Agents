{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install && npm run build"
  },
  "deploy": {
    "startCommand": "npm install -g serve && serve -s dist -l 3000",
    "healthcheckPath": "/",
    "restartPolicy": "always"
  }
}
