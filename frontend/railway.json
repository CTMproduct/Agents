{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install && npm run build"
  },
  "deploy": {
    "startCommand": "npm install -g http-server && http-server dist -p 3000 -c-1",
    "healthcheckPath": "/",
    "restartPolicy": "always",
    "restartPolicyMaxRetries": 5
  }
}
