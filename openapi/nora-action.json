{
  "openapi": "3.1.1",
  "info": {
    "title": "Nora Conversation Capture Action",
    "version": "1.2.0",
    "description": "OpenAPI schema for the ChatGPT action that sends conversation captures, hotel feedback and human-escalation data to the Nora backend."
  },
  "servers": [
    {
      "url": "https://agents-production-5abe.up.railway.app",
      "description": "Production backend on Railway"
    }
  ],
  "paths": {
    "/api/chat": {
      "post": {
        "summary": "Genera respuesta de Nora con GPT",
        "operationId": "generateNoraResponse",
        "security": [{ "GptApiKeyAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequestPayload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Respuesta generada con éxito",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "400": {
            "description": "Solicitud inválida"
          },
          "401": {
            "description": "X-Gpt-Api-Key inválida o ausente (solo si el backend la tiene configurada)"
          },
          "500": {
            "description": "Error interno del servidor"
          }
        }
      }
    },
    "/api/chat-capturar": {
      "post": {
        "summary": "Genera una respuesta de Nora y captura la conversación en el backend",
        "operationId": "generateAndCaptureConversation",
        "security": [{ "GptApiKeyAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatCaptureRequestPayload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Respuesta generada y conversación capturada con éxito",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatCaptureResponse"
                }
              }
            }
          },
          "400": {
            "description": "Solicitud inválida"
          },
          "401": {
            "description": "X-Gpt-Api-Key inválida o ausente (solo si el backend la tiene configurada)"
          },
          "500": {
            "description": "Error interno del servidor"
          }
        }
      }
    },
    "/api/capturar-conversacion": {
      "post": {
        "summary": "Captura una conversación de Nora, opcionalmente con feedback del hotel",
        "description": "Registra una conversación. Si en ese mismo momento ya se sabe cómo reaccionó el hotel (positivo/negativo, alucinación, escalado a un humano), se puede enviar junto con la captura usando los campos de feedback_* y escalation_*. Si la reacción llega después, usa PATCH /api/conversations/{id}/feedback con el conversationId que devuelve esta llamada.",
        "operationId": "captureConversation",
        "security": [{ "GptApiKeyAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaptureConversationPayload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Captura registrada con éxito",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaptureConversationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Solicitud inválida (falta pregunta/respuesta, o feedback_rating/feedback_category tienen un valor no permitido)"
          },
          "401": {
            "description": "X-Gpt-Api-Key inválida o ausente (solo si el backend la tiene configurada)"
          },
          "500": {
            "description": "Error interno del servidor"
          }
        }
      }
    },
    "/api/conversations/{id}/feedback": {
      "patch": {
        "summary": "Registra el feedback del hotel sobre una conversación ya capturada",
        "description": "Úsalo cuando la reacción del hotel (positiva/negativa, si fue una alucinación, si se escaló a una persona) llega en un turno posterior al de la captura original. El id es el conversationId devuelto por captureConversation.",
        "operationId": "registrarFeedbackConversacion",
        "security": [{ "GptApiKeyAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "example": "conv_123456"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConversationFeedbackPayload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Feedback registrado con éxito"
          },
          "400": {
            "description": "feedback_rating o feedback_category invalidos, o no se envio ningun campo"
          },
          "401": {
            "description": "X-Gpt-Api-Key inválida o ausente (solo si el backend la tiene configurada)"
          },
          "404": {
            "description": "No existe una conversacion con ese id"
          },
          "500": {
            "description": "Error interno del servidor"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "GptApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Gpt-Api-Key",
        "description": "Debe coincidir con GPT_ACTION_API_KEY configurada en Railway. Mientras esa variable no exista, el backend acepta llamadas sin este header (compatibilidad con la Action actual)."
      }
    },
    "schemas": {
      "CaptureConversationPayload": {
        "type": "object",
        "required": [
          "pregunta",
          "respuesta"
        ],
        "properties": {
          "agent_id": {
            "type": "string",
            "example": "agent_nora"
          },
          "agent_slug": {
            "type": "string",
            "example": "nora"
          },
          "asistente_nombre": {
            "type": "string",
            "example": "NORA"
          },
          "pregunta": {
            "type": "string",
            "example": "¿Cuál es el mejor plan de viaje para Cartagena?"
          },
          "respuesta": {
            "type": "string",
            "example": "El mejor plan es..."
          },
          "usuario_nombre": {
            "type": "string",
            "example": "Carlos"
          },
          "usuario_email": {
            "type": "string",
            "format": "email",
            "example": "carlos@example.com"
          },
          "usuario_id": {
            "type": "string",
            "example": "user_123"
          },
          "region": {
            "type": "string",
            "example": "Nora"
          },
          "status": {
            "type": "string",
            "example": "capturada"
          },
          "feedback_rating": {
            "$ref": "#/components/schemas/FeedbackRating"
          },
          "feedback_category": {
            "$ref": "#/components/schemas/FeedbackCategory"
          },
          "feedback_comment": {
            "type": "string",
            "description": "Cita corta de lo que dijo el hotel",
            "example": "El horario real es 2pm, no 3pm"
          },
          "escalated_to_human": {
            "type": "boolean",
            "default": false,
            "example": false
          },
          "escalation_target": {
            "type": "string",
            "description": "A quien se escalo, por ejemplo hyperguest",
            "example": "hyperguest"
          },
          "escalation_reason": {
            "type": "string",
            "example": "El hotel pidio hablar con una persona"
          }
        }
      },
      "ConversationFeedbackPayload": {
        "type": "object",
        "description": "Al menos uno de feedback_rating, feedback_category o escalated_to_human es requerido.",
        "properties": {
          "feedback_rating": {
            "$ref": "#/components/schemas/FeedbackRating"
          },
          "feedback_category": {
            "$ref": "#/components/schemas/FeedbackCategory"
          },
          "feedback_comment": {
            "type": "string",
            "example": "El horario real es 2pm, no 3pm"
          },
          "escalated_to_human": {
            "type": "boolean",
            "example": true
          },
          "escalation_target": {
            "type": "string",
            "example": "hyperguest"
          },
          "escalation_reason": {
            "type": "string",
            "example": "El hotel pidio hablar con una persona"
          }
        }
      },
      "FeedbackRating": {
        "type": "string",
        "enum": ["positive", "negative", "neutral"],
        "description": "Como reacciono el hotel a la respuesta, si lo expreso explicitamente"
      },
      "FeedbackCategory": {
        "type": "string",
        "enum": [
          "accurate_helpful",
          "hallucination",
          "incomplete",
          "irrelevant",
          "needs_human",
          "other"
        ],
        "description": "Usa 'hallucination' SOLO cuando el hotel indico explicitamente que la informacion era incorrecta o inventada. Nunca la marques por tu propia duda interna."
      },
      "ChatCaptureRequestPayload": {
        "type": "object",
        "required": [
          "pregunta"
        ],
        "properties": {
          "agent_id": {
            "type": "string",
            "example": "agent_nora"
          },
          "agent_slug": {
            "type": "string",
            "example": "nora"
          },
          "pregunta": {
            "type": "string",
            "example": "Necesito ayuda para reservar un hotel en Cartagena"
          },
          "usuario_nombre": {
            "type": "string",
            "example": "Carlos"
          },
          "usuario_email": {
            "type": "string",
            "format": "email",
            "example": "carlos@example.com"
          },
          "usuario_id": {
            "type": "string",
            "example": "user_123"
          },
          "region": {
            "type": "string",
            "example": "Nora"
          }
        }
      },
      "ChatCaptureResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "respuesta": {
            "type": "string",
            "example": "Claro, te ayudo con opciones de hotel en Cartagena."
          },
          "modelo": {
            "type": "string",
            "example": "gpt-4o-mini"
          },
          "conversationId": {
            "type": "string",
            "example": "conv_123456"
          },
          "score_promedio": {
            "type": "number",
            "example": 4.7
          },
          "database": {
            "type": "string",
            "example": "Memory"
          },
          "agent": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "slug": {
                "type": "string"
              }
            }
          }
        }
      },
      "CaptureConversationResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "mensaje": {
            "type": "string",
            "example": "Captura registrada correctamente"
          },
          "message": {
            "type": "string",
            "example": "Captura registrada correctamente"
          },
          "data": {
            "type": "object",
            "properties": {
              "conversationId": {
                "type": "string",
                "example": "conv_123456"
              }
            }
          },
          "score_promedio": {
            "type": "number",
            "example": 4.7
          },
          "agent": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "slug": {
                "type": "string"
              }
            }
          }
        }
      },
      "ChatRequestPayload": {
        "type": "object",
        "required": [
          "pregunta"
        ],
        "properties": {
          "agent_id": {
            "type": "string",
            "example": "agent_nora"
          },
          "agent_slug": {
            "type": "string",
            "example": "nora"
          },
          "pregunta": {
            "type": "string",
            "example": "Necesito ayuda para reservar un hotel en Cartagena"
          },
          "usuario_nombre": {
            "type": "string",
            "example": "Carlos"
          },
          "usuario_email": {
            "type": "string",
            "format": "email",
            "example": "carlos@example.com"
          },
          "usuario_id": {
            "type": "string",
            "example": "user_123"
          },
          "region": {
            "type": "string",
            "example": "Nora"
          }
        }
      },
      "ChatResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "respuesta": {
            "type": "string",
            "example": "Claro, te ayudo con opciones de hotel en Cartagena."
          },
          "modelo": {
            "type": "string",
            "example": "gpt-4o-mini"
          },
          "agent": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "slug": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
