# Frontend Configuration - Nora Dashboard

# Backend API URL
# LOCAL: http://localhost:3000
# PRODUCTION: https://your-backend-domain.onrender.com
VITE_API_BASE_URL=http://localhost:3000

# Refresh interval for real-time updates (milliseconds)
VITE_REFRESH_INTERVAL=30000

# Enable/disable real-time polling
VITE_ENABLE_REALTIME=true

# Dashboard sections visibility
VITE_SHOW_HALLUCINATION_ANALYSIS=true
VITE_SHOW_PERFORMANCE_METRICS=true
VITE_SHOW_CONVERSATION_METRICS=true

# Debug mode
VITE_DEBUG_MODE=false
