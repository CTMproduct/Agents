{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build:all"
  },
  "deploy": {
    "startCommand": "npm run start",
    "restartPolicyType": "always",
    "restartPolicyMaxRetries": 5,
    "healthcheckPath": "/health"
  }
}
