// Agentic Revenue OS - Fase 1 (MVP: Agentic Lead Intake)
// Regla arquitectónica: el CRM guarda la verdad. Los agentes solo proponen.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum CustomerType {
  DIRECT_CLIENT
  AGENCY
  FREELANCER
  CORPORATE
  GROUP
  UNKNOWN
}

enum ChannelType {
  WHATSAPP
  WEBCHAT
  EMAIL
  INSTAGRAM
  FACEBOOK
  PHONE
}

enum LeadIntent {
  INFORMATION
  QUOTE_REQUEST
  READY_TO_BOOK
  POST_SALE
  COMPLAINT
  UNKNOWN
}

enum LeadStatus {
  NEW
  QUALIFIED
  IN_PROGRESS
  ESCALATED
  WON
  LOST
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum SuggestedReplyStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT
}

enum AutonomyLevel {
  L0_HUMAN_APPROVES_ALL // nivel inicial: humano aprueba el 100%
  L1_AUTO_INFORMATIONAL // se gana con <2% error en evals durante 4 semanas
  L2_AUTO_FOLLOWUP
  L3_AUTO_QUOTE_DRAFT
}

// ---------- CRM Core ----------

model Account {
  id           String       @id @default(cuid())
  name         String
  customerType CustomerType @default(UNKNOWN)
  nit          String?      @unique
  contacts     Contact[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Contact {
  id                String            @id @default(cuid())
  fullName          String?
  email             String?
  phone             String?
  customerType      CustomerType      @default(UNKNOWN)
  account           Account?          @relation(fields: [accountId], references: [id])
  accountId         String?
  channelIdentities ChannelIdentity[]
  leads             Lead[]
  conversations     Conversation[]
  consents          Consent[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model ChannelIdentity {
  id         String      @id @default(cuid())
  channel    ChannelType
  externalId String // ej. numero de WhatsApp, session id de webchat
  contact    Contact     @relation(fields: [contactId], references: [id])
  contactId  String
  createdAt  DateTime    @default(now())

  @@unique([channel, externalId])
}

model Lead {
  id             String     @id @default(cuid())
  contact        Contact    @relation(fields: [contactId], references: [id])
  contactId      String
  intent         LeadIntent @default(UNKNOWN)
  status         LeadStatus @default(NEW)
  destination    String?
  travelDateFrom DateTime?
  travelDateTo   DateTime?
  paxAdults      Int?
  paxChildren    Int?
  budgetAmount   Decimal?   @db.Decimal(14, 2)
  budgetCurrency String?
  score          Float? // 0..1, producido por LeadQualification
  scoreReason    String?
  tasks          Task[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Conversation {
  id               String           @id @default(cuid())
  contact          Contact          @relation(fields: [contactId], references: [id])
  contactId        String
  channel          ChannelType
  summary          String?
  messages         Message[]
  suggestedReplies SuggestedReply[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model Message {
  id             String           @id @default(cuid())
  conversation   Conversation     @relation(fields: [conversationId], references: [id])
  conversationId String
  direction      MessageDirection
  channel        ChannelType
  body           String
  rawPayload     Json? // payload crudo del webhook, para auditoría/debug
  externalId     String?
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}

model Task {
  id          String    @id @default(cuid())
  lead        Lead      @relation(fields: [leadId], references: [id])
  leadId      String
  title       String
  description String?
  dueAt       DateTime?
  done        Boolean   @default(false)
  createdAt   DateTime  @default(now())
}

model Consent {
  id        String      @id @default(cuid())
  contact   Contact     @relation(fields: [contactId], references: [id])
  contactId String
  channel   ChannelType
  granted   Boolean
  source    String? // ej. "opt-in webchat", "primer mensaje entrante WhatsApp"
  createdAt DateTime    @default(now())
}

// ---------- Capa de agentes (todo se audita) ----------

model AgentRun {
  id                  String   @id @default(cuid())
  agentName           String
  modelProvider       String
  modelName           String
  inputSummary        String
  outputJson          Json
  latencyMs           Int
  inputTokens         Int?
  outputTokens        Int?
  confidenceScore     Float?
  humanReviewRequired Boolean  @default(true) // L0: siempre true
  traceId             String
  createdAt           DateTime @default(now())

  @@index([agentName, createdAt])
}

model SuggestedReply {
  id             String               @id @default(cuid())
  conversation   Conversation         @relation(fields: [conversationId], references: [id])
  conversationId String
  body           String
  status         SuggestedReplyStatus @default(PENDING_APPROVAL)
  agentRunId     String?
  approvedBy     String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

model AuditEvent {
  id        String   @id @default(cuid())
  eventType String // lead.created, message.received, agent.run.completed, reply.approved...
  entity    String?
  entityId  String?
  actor     String // "system" | "agent:<nombre>" | "user:<id>"
  payload   Json?
  traceId   String?
  createdAt DateTime @default(now())

  @@index([eventType, createdAt])
}

// ---------- Conocimiento con proveniencia estricta (Fase 3, modelo desde ya) ----------
// Regla dura: sin documento vigente, el agente NUNCA cotiza.

model KnowledgeDocument {
  id                     String    @id @default(cuid())
  title                  String
  source                 String // ej. "tarifario-palladium-2026.pdf"
  supplier               String?
  market                 String? // ej. "CARIBE", "EUROPA"
  currency               String?
  validFrom              DateTime?
  validTo                DateTime?
  customerTypeVisibility CustomerType[]
  content                String
  createdAt              DateTime  @default(now())

  @@index([validFrom, validTo])
}

// ---------- Configuración de autonomía (Responsible Scaling interno) ----------

model AutonomyPolicy {
  id           String        @id @default(cuid())
  taskCategory String        @unique // ej. "informational_reply", "followup", "quote_draft"
  level        AutonomyLevel @default(L0_HUMAN_APPROVES_ALL)
  evalErrorPct Float? // último error medido en evals; el gate para subir de nivel
  updatedAt    DateTime      @updatedAt
}
