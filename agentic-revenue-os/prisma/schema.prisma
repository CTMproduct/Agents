// Agentic Revenue OS - Fase 1 (MVP: Agentic Lead Intake)
// Regla arquitectónica: el CRM guarda la verdad. Los agentes solo proponen.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum CustomerType {
  DIRECT_CLIENT
  AGENCY
  FREELANCER
  CORPORATE
  GROUP
  UNKNOWN
}

enum ChannelType {
  WHATSAPP
  WEBCHAT
  EMAIL
  INSTAGRAM
  FACEBOOK
  PHONE
}

enum LeadIntent {
  INFORMATION
  QUOTE_REQUEST
  READY_TO_BOOK
  POST_SALE
  COMPLAINT
  UNKNOWN
}

enum LeadStatus {
  NEW
  QUALIFIED
  IN_PROGRESS
  ESCALATED
  WON
  LOST
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum SuggestedReplyStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT
}

enum AutonomyLevel {
  L0_HUMAN_APPROVES_ALL // nivel inicial: humano aprueba el 100%
  L1_AUTO_INFORMATIONAL // se gana con <2% error en evals durante 4 semanas
  L2_AUTO_FOLLOWUP
  L3_AUTO_QUOTE_DRAFT
}

enum UserRole {
  PLATFORM_ADMIN // tu cuenta: ve todos los tenants
  TENANT_ADMIN // administra agentes, workflows, secretos y usuarios de su empresa
  TENANT_MEMBER // opera: revisa, aprueba, prueba agentes
  TENANT_REVIEWER // solo puede decidir en Human Review
  TENANT_VIEWER // solo lectura
}

enum AgentCategory {
  SDR
  SALES_FOLLOWUP
  COLLECTIONS
  SUPPORT
  CUSTOM
}

// ---------- CRM Core ----------

model Account {
  id           String       @id @default(cuid())
  name         String
  customerType CustomerType @default(UNKNOWN)
  nit          String?      @unique
  contacts     Contact[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Contact {
  id                String            @id @default(cuid())
  fullName          String?
  email             String?
  phone             String?
  customerType      CustomerType      @default(UNKNOWN)
  account           Account?          @relation(fields: [accountId], references: [id])
  accountId         String?
  channelIdentities ChannelIdentity[]
  leads             Lead[]
  conversations     Conversation[]
  consents          Consent[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model ChannelIdentity {
  id         String      @id @default(cuid())
  channel    ChannelType
  externalId String // ej. numero de WhatsApp, session id de webchat
  contact    Contact     @relation(fields: [contactId], references: [id])
  contactId  String
  createdAt  DateTime    @default(now())

  @@unique([channel, externalId])
}

model Lead {
  id             String     @id @default(cuid())
  contact        Contact    @relation(fields: [contactId], references: [id])
  contactId      String
  intent         LeadIntent @default(UNKNOWN)
  status         LeadStatus @default(NEW)
  destination    String?
  travelDateFrom DateTime?
  travelDateTo   DateTime?
  paxAdults      Int?
  paxChildren    Int?
  budgetAmount   Decimal?   @db.Decimal(14, 2)
  budgetCurrency String?
  score          Float? // 0..1, producido por LeadQualification
  scoreReason    String?
  tasks          Task[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Conversation {
  id               String           @id @default(cuid())
  contact          Contact          @relation(fields: [contactId], references: [id])
  contactId        String
  channel          ChannelType
  summary          String?
  messages         Message[]
  suggestedReplies SuggestedReply[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model Message {
  id             String           @id @default(cuid())
  conversation   Conversation     @relation(fields: [conversationId], references: [id])
  conversationId String
  direction      MessageDirection
  channel        ChannelType
  body           String
  rawPayload     Json? // payload crudo del webhook, para auditoría/debug
  externalId     String?
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}

model Task {
  id          String    @id @default(cuid())
  lead        Lead      @relation(fields: [leadId], references: [id])
  leadId      String
  title       String
  description String?
  dueAt       DateTime?
  done        Boolean   @default(false)
  createdAt   DateTime  @default(now())
}

model Consent {
  id        String      @id @default(cuid())
  contact   Contact     @relation(fields: [contactId], references: [id])
  contactId String
  channel   ChannelType
  granted   Boolean
  source    String? // ej. "opt-in webchat", "primer mensaje entrante WhatsApp"
  createdAt DateTime    @default(now())
}

// ---------- Capa de agentes (todo se audita) ----------

model AgentRun {
  id                  String   @id @default(cuid())
  agentName           String
  modelProvider       String
  modelName           String
  inputSummary        String
  outputJson          Json
  latencyMs           Int
  inputTokens         Int?
  outputTokens        Int?
  confidenceScore     Float?
  humanReviewRequired Boolean  @default(true) // L0: siempre true
  traceId             String
  tenantId            String? // null = agente interno de CTM; con valor = agente de un tenant del marketplace
  createdAt           DateTime @default(now())

  @@index([agentName, createdAt])
  @@index([tenantId, createdAt])
}

model SuggestedReply {
  id             String               @id @default(cuid())
  conversation   Conversation         @relation(fields: [conversationId], references: [id])
  conversationId String
  body           String
  status         SuggestedReplyStatus @default(PENDING_APPROVAL)
  agentRunId     String?
  approvedBy     String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

model AuditEvent {
  id        String   @id @default(cuid())
  eventType String // lead.created, message.received, agent.run.completed, reply.approved...
  entity    String?
  entityId  String?
  actor     String // "system" | "agent:<nombre>" | "user:<id>"
  payload   Json?
  traceId   String?
  createdAt DateTime @default(now())

  @@index([eventType, createdAt])
}

// ---------- Conocimiento con proveniencia estricta (Fase 3, modelo desde ya) ----------
// Regla dura: sin documento vigente, el agente NUNCA cotiza.

model KnowledgeDocument {
  id                     String    @id @default(cuid())
  title                  String
  source                 String // ej. "tarifario-palladium-2026.pdf"
  supplier               String?
  market                 String? // ej. "CARIBE", "EUROPA"
  currency               String?
  validFrom              DateTime?
  validTo                DateTime?
  customerTypeVisibility CustomerType[]
  content                String
  createdAt              DateTime  @default(now())

  @@index([validFrom, validTo])
}

// ---------- Registro dinámico de agentes (plataforma no monolítica) ----------
// Cada fila es un agente independiente (ventas, soporte, cierre...). Se agrega
// o desactiva sin tocar código: nuevo agente = nueva fila + prompt + toolKeys.
// toolKeys referencia entradas del ToolRegistry en código (conectores plug-in).

model AgentDefinition {
  id           String   @id @default(cuid())
  key          String   @unique // "sales" | "support" | "closing" | ...
  name         String // nombre visible en el dashboard de costos
  role         String // descripcion corta del rol comercial
  systemPrompt String
  toolKeys     String[] // ej. ["knowledge_search", "crm_lookup", "web_search"]
  modelName    String? // LLM propio del agente (null = modelo por defecto de la plataforma)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------- Configuración de autonomía (Responsible Scaling interno) ----------

model AutonomyPolicy {
  id           String        @id @default(cuid())
  taskCategory String        @unique // ej. "informational_reply", "followup", "quote_draft"
  level        AutonomyLevel @default(L0_HUMAN_APPROVES_ALL)
  evalErrorPct Float? // último error medido en evals; el gate para subir de nivel
  updatedAt    DateTime      @updatedAt
}

// ---------- Marketplace multi-tenant (empresas que contratan agentes) ----------
// Capa aditiva y separada del CRM interno de CTM: cada empresa (Tenant) activa
// sus propios agentes a partir de un catálogo (AgentTemplate), los edita con
// su propio archivo de skill en markdown y sus conectores, y los califica.

model Tenant {
  id        String        @id @default(cuid())
  name      String
  slug      String        @unique
  createdAt DateTime      @default(now())
  users     User[]
  agents    TenantAgent[]
  reviews   AgentReview[]
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         UserRole  @default(TENANT_MEMBER)
  tenant       Tenant?   @relation(fields: [tenantId], references: [id])
  tenantId     String?
  createdAt    DateTime  @default(now())
}

// Catálogo público del marketplace (las tarjetas "Probar Gratis").
model AgentTemplate {
  id              String        @id @default(cuid())
  key             String        @unique // "sdr" | "sales_followup" | "collections"
  name            String
  tagline         String
  category        AgentCategory
  avatarEmoji     String // marcador visual simple para la mascota ilustrada
  accentColor     String // hex, define el degradado de la tarjeta
  features        String[] // bullets mostrados en la tarjeta
  defaultSkillMd  String // contenido markdown inicial al activar (editable despues)
  defaultToolKeys String[]
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  tenantAgents    TenantAgent[]
  reviews         AgentReview[]
}

// Instancia de un agente para UN tenant especifico: su propia copia editable
// del skill.md y sus conectores. "Crea el Tuyo" = TenantAgent sin templateId.
model TenantAgent {
  id         String         @id @default(cuid())
  tenant     Tenant         @relation(fields: [tenantId], references: [id])
  tenantId   String
  template   AgentTemplate? @relation(fields: [templateId], references: [id])
  templateId String?
  name       String
  skillMd    String // el skill principal del agente: system prompt en markdown, editable
  toolKeys   String[]
  modelName  String? // LLM propio del agente (null = modelo por defecto de la plataforma)
  active     Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  skills    TenantAgentSkill[]
  knowledge TenantAgentKnowledge[]

  @@index([tenantId])
}

// Skills adicionales (.md) del agente: se componen en orden despues del skill
// principal para formar el system prompt final. Editable por el tenant.
model TenantAgentSkill {
  id            String      @id @default(cuid())
  tenantAgent   TenantAgent @relation(fields: [tenantAgentId], references: [id], onDelete: Cascade)
  tenantAgentId String
  name          String // ej. "tono-de-marca.md", "politica-de-descuentos.md"
  contentMd     String
  position      Int         @default(0)
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([tenantAgentId, position])
}

// Knowledge base propia del agente: documentos que consulta en runtime via la
// herramienta agent_knowledge (aislada por agente -- nunca cruza tenants).
model TenantAgentKnowledge {
  id            String      @id @default(cuid())
  tenantAgent   TenantAgent @relation(fields: [tenantAgentId], references: [id], onDelete: Cascade)
  tenantAgentId String
  title         String
  content       String
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([tenantAgentId])
}

// Calificacion de una empresa (tenant) sobre una plantilla del catalogo.
model AgentReview {
  id         String        @id @default(cuid())
  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  tenantId   String
  template   AgentTemplate @relation(fields: [templateId], references: [id])
  templateId String
  rating     Int // 1..5
  comment    String?
  createdAt  DateTime      @default(now())

  @@unique([tenantId, templateId])
}

// ---------- Automation Studio (workflows visuales tipo n8n) ----------

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum ExecutionStatus {
  QUEUED
  RUNNING
  WAITING_FOR_APPROVAL
  SUCCESS
  FAILED
  CANCELLED
}

model AutomationWorkflow {
  id            String         @id @default(cuid())
  tenantId      String
  tenantAgentId String? // agente por defecto para los nodos agent.run
  name          String
  description   String?
  status        WorkflowStatus @default(DRAFT)
  triggerType   String         @default("manual") // manual | webhook
  nodes         Json // [{id, type, position:{x,y}, data}]
  edges         Json // [{id, source, target}]
  version       Int            @default(1)
  publicId      String?        @unique // para POST /automations/webhook/:publicId
  webhookSecret String? // si esta definido, el webhook exige header x-webhook-secret
  lastRunAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  executions AutomationExecution[]

  @@index([tenantId])
}

model AutomationExecution {
  id          String          @id @default(cuid())
  workflow    AutomationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowId  String
  tenantId    String
  status      ExecutionStatus @default(RUNNING)
  input       Json?
  nodeOutputs Json? // { [nodeId]: {status, output, error, latencyMs} } -- ejecucion paso a paso
  output      Json? // respuesta final (nodo webhook.response si existe)
  error       String?
  pausedNodeId String? // nodo en el que quedo pausada esperando aprobacion humana
  startedAt   DateTime        @default(now())
  finishedAt  DateTime?

  reviews PendingReview[]

  @@index([tenantId, startedAt])
}

// ---------- Human Review Console (multi-tenant) ----------

enum ReviewStatus {
  PENDING
  APPROVED
  EDITED
  REJECTED
  ESCALATED
}

model PendingReview {
  id            String       @id @default(cuid())
  tenantId      String
  tenantAgentId String?
  execution     AutomationExecution? @relation(fields: [executionId], references: [id], onDelete: Cascade)
  executionId   String?
  agentRunId    String?
  channel       String? // origen: workflow | test | webhook
  inputSummary  String // mensaje del cliente / input del nodo
  suggestedOutput String // lo que el agente propone
  finalOutput   String? // lo que el humano dejo (si edito)
  status        ReviewStatus @default(PENDING)
  reviewedBy    String?
  learningNote  String? // "guardar como aprendizaje"
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([tenantId, status, createdAt])
}

// Vault de secretos por tenant: valores cifrados AES-256-GCM con ENCRYPTION_KEY.
// Write-only: la API nunca devuelve el valor, solo nombre y fecha.
model SecretCredential {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  encryptedValue String // hex: iv + tag + ciphertext
  createdBy      String?
  createdAt      DateTime @default(now())

  @@unique([tenantId, name])
}

// Versionado de workflows: cada cambio de nodos/edges guarda la version anterior.
model WorkflowVersion {
  id         String   @id @default(cuid())
  workflowId String
  version    Int
  nodes      Json
  edges      Json
  changedBy  String?
  createdAt  DateTime @default(now())

  @@index([workflowId, version])
}

// Metricas diarias por agente (Fase 8): fila por agente y dia, recalculada
// de forma perezosa al consultar metricas. Base para tendencias y ROI.
model AgentDailyMetric {
  id            String   @id @default(cuid())
  tenantId      String
  tenantAgentId String
  date          DateTime @db.Date
  runs          Int      @default(0)
  approvals     Int      @default(0)
  rejections    Int      @default(0)
  edits         Int      @default(0)
  escalations   Int      @default(0)
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  costUsd       Decimal  @default(0) @db.Decimal(12, 6)
  avgLatencyMs  Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([tenantAgentId, date])
  @@index([tenantId, date])
}

// Versionado de prompts: cada cambio al skillMd principal guarda la version anterior.
model TenantAgentPromptVersion {
  id            String   @id @default(cuid())
  tenantAgentId String
  version       Int
  skillMd       String
  changedBy     String?
  createdAt     DateTime @default(now())

  @@index([tenantAgentId, version])
}

// ---------- Learning Loops: propuestas de mejora (nunca cambian el prompt solas) ----------

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

model AgentSkillProposal {
  id            String         @id @default(cuid())
  tenantId      String
  tenantAgentId String
  proposalType  String         @default("skill_update") // skill_update | memory | guardrail
  title         String
  proposedValue String // contenido .md propuesto
  reason        String
  evidence      Json? // { editedReplies, rejectedReplies, examples }
  status        ProposalStatus @default(PENDING)
  decidedBy     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([tenantId, status])
}
// -----------------------------------------------------------------------------
// AGENTIC ARENA MODULE
// Añadir al final de prisma/schema.prisma.
// No toca tablas existentes; referencia TenantAgent de forma lógica por agentId.
// -----------------------------------------------------------------------------

enum ArenaBattleStatus {
  PENDING
  RESOLVED
  FAILED
  CANCELLED
}

enum ArenaTaskType {
  PACKAGE_ASSEMBLY
  PROMPT_EVALUATION
  HUMAN_REVIEW
  CUSTOM
}

model AgentProfile {
  id        String   @id @default(uuid())
  tenantId  String
  agentId   String   // Referencia lógica a TenantAgent.id
  alias     String
  avatarUrl String   @default("https://models.readyplayer.me/64bfa15f0e72c63d7c3934a6.glb")

  level  Int @default(1)
  xp     Int @default(0)
  elo    Int @default(1000)
  wins   Int @default(0)
  losses Int @default(0)
  draws  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  battles BattleParticipant[]

  @@unique([tenantId, agentId])
  @@index([tenantId])
  @@index([tenantId, elo])
}

model Battle {
  id        String            @id @default(uuid())
  tenantId  String
  taskType  ArenaTaskType     @default(PACKAGE_ASSEMBLY)
  status    ArenaBattleStatus @default(PENDING)

  winnerParticipantId String?
  createdByUserId     String?
  promptHash          String?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  participants BattleParticipant[]

  @@index([tenantId, status, createdAt])
}

model BattleParticipant {
  id        String @id @default(uuid())
  battleId  String
  profileId String

  // Snapshots para auditoría aunque el agente/perfil cambie después
  agentIdSnapshot String
  aliasSnapshot   String
  modelSnapshot   String

  outputData   Json?
  errorMessage String?

  inputTokens  Int     @default(0)
  outputTokens Int     @default(0)
  tokenCost    Decimal @default(0)
  latencyMs    Int     @default(0)

  approved Boolean?

  createdAt DateTime @default(now())

  battle  Battle       @relation(fields: [battleId], references: [id], onDelete: Cascade)
  profile AgentProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)

  @@unique([battleId, profileId])
  @@index([profileId])
}
