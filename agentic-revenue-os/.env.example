# Base de datos: Docker Compose la levanta con estos valores.
# Alternativa sin Docker: un PostgreSQL local con rol ctm y DB agentic_revenue_os funciona igual.
DATABASE_URL="postgresql://ctm:ctm_dev_password@localhost:5432/agentic_revenue_os?schema=public"

# Anthropic API (https://console.anthropic.com)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# App
PORT=3000
NODE_ENV=development

# Seguridad basica del webhook (token compartido para mocks/dev)
WEBHOOK_SHARED_SECRET="cambia-este-valor"

# Umbral de confianza: por debajo de esto, siempre escala a humano
CONFIDENCE_THRESHOLD=0.75

# Marketplace multi-tenant: firma de los JWT de sesion (genera un valor largo y aleatorio)
JWT_SECRET="cambia-este-valor-por-uno-aleatorio-largo"

# Tu cuenta de administrador de plataforma (opcional: solo se crea si ambas estan definidas)
PLATFORM_ADMIN_EMAIL=""
PLATFORM_ADMIN_PASSWORD=""

# Vault de secretos por tenant: clave maestra AES-256-GCM (genera un valor largo y aleatorio)
ENCRYPTION_KEY="cambia-este-valor-por-uno-aleatorio-largo"

# Rate limiting (opcional: valores por defecto 120 req / 60s)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Frontend React separado: origen permitido en CORS (opcional en dev)
WEB_URL="http://localhost:5173"

# Memoria semantica del Training Camp. Backend de embeddings:
#   local (default, determinista, sin key ni red) | openai | gemini | voyage
# Para memoria NEURAL de verdad, pon uno de estos y su API key correspondiente.
EMBEDDINGS_PROVIDER="local"
# EMBEDDINGS_MODEL=""            # opcional; default por proveedor (openai: text-embedding-3-small)
# OPENAI_API_KEY=""             # embeddings OpenAI (muy barato) y/o modelos GPT
# GEMINI_API_KEY=""             # embeddings Google (text-embedding-004, tiene free tier)
# VOYAGE_API_KEY=""             # embeddings Voyage AI (voyage-3-lite)
