{
  "name": "agentic-revenue-os",
  "version": "0.1.0",
  "description": "Agentic Revenue OS - CTM En Linea. MVP Fase 1: Agentic Lead Intake (WhatsApp/Webchat -> extraccion estructurada -> respuesta sugerida -> aprobacion humana).",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node node_modules/@nestjs/cli/bin/nest.js build",
    "start": "node dist/src/main.js",
    "start:dev": "node node_modules/@nestjs/cli/bin/nest.js start --watch",
    "test": "node node_modules/jest/bin/jest.js",
    "test:e2e": "node node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
    "postinstall": "node node_modules/prisma/build/index.js generate",
    "prisma:generate": "node node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node node_modules/prisma/build/index.js migrate dev",
    "prisma:deploy": "node node_modules/prisma/build/index.js migrate deploy",
    "prisma:seed": "node node_modules/ts-node/dist/bin.js prisma/seed.ts",
    "evals": "node node_modules/ts-node/dist/bin.js evals/run-evals.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/event-emitter": "^2.0.4",
    "@nestjs/platform-express": "^10.4.0",
    "@prisma/client": "^5.19.0",
    "openai": "^6.45.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/testing": "^10.4.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "^5.19.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
